        >
          <component :is="tab.icon" class="tab-icon" />
          {{ tab.label }}
        </button>
      </div>

      <!-- Content area -->
      <div class="content-container">
        <!-- Archive Management Tab -->
        <div v-if="activeTab === 'archive'" class="tab-content">
          <div class="content-header">
