            <p>Import and analyze your AI conversation history</p>
          </div>
          
          <!-- Archive sub-tabs -->
          <div class="sub-tabs">
            <button 
              @click="archiveStore.setActiveTab('upload')"
              :class="{ 'active': archiveStore.activeTab === 'upload' }"
              class="sub-tab"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
