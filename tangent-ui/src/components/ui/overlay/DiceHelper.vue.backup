<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { useArchiveStore } from '@/stores/archiveStore'
import { Upload, Keyboard, Lightbulb, Settings, MousePointer, Sparkles, Zap, Target, Layers } from 'lucide-vue-next'
import ArchiveUpload from '@/components/archive/ArchiveUpload.vue'
import ArchiveExploration from '@/components/archive/ArchiveExploration.vue'

const props = defineProps<{
  isOpen: boolean
}>()

const emit = defineEmits<{
  (e: 'close'): void
  (e: 'toggle'): void
}>()

// State
const activeTab = ref('archive')
const archiveStore = useArchiveStore()

// Initialize archive store
onMounted(() => {
  archiveStore.initialize()
})

// Navigation tabs
const tabs = [
  { id: 'archive', label: 'Archive', icon: Upload },
  { id: 'shortcuts', label: 'Shortcuts', icon: Keyboard },
  { id: 'tips', label: 'Tips', icon: Lightbulb },
  { id: 'settings', label: 'Settings', icon: Settings }
]

// Shortcuts organized by category
const shortcutCategories = [
  {
    name: 'Navigation',
    shortcuts: [
      { keys: ['?'], description: 'Toggle this help panel' },
      { keys: ['ESC'], description: 'Close panels or exit modes' },
      { keys: ['↑', '↓', '←', '→'], description: 'Navigate between nodes' },
      { keys: ['SPACE'], description: 'Pan the canvas' }
    ]
  },
  {
    name: 'Canvas',
    shortcuts: [
      { keys: ['CTRL', '+'], description: 'Zoom in' },
      { keys: ['CTRL', '-'], description: 'Zoom out' },
      { keys: ['CTRL', '0'], description: 'Reset zoom' },
      { keys: ['S'], description: 'Toggle snap mode' }
    ]
  },
  {
    name: 'Models & Search',
    shortcuts: [
      { keys: ['M'], description: 'Open model selector' },
      { keys: ['/'], description: 'Search models and components' },
      { keys: ['CTRL', 'K'], description: 'Quick command palette' }
    ]
  }
]

// Tips and tricks
const tips = [
  {
    icon: Upload,
    title: 'Import Your Conversations',
    description: 'Upload ChatGPT or Claude conversation exports to create interactive workspaces and analyze your conversation patterns.'
  },
  {
    icon: Sparkles,
    title: 'Enable Embeddings',
    description: 'Turn on embeddings during import to unlock semantic search, topic clustering, and conversation analytics.'
  },
  {
    icon: Target,
    title: 'Discover Patterns',
    description: 'Use topic exploration to find unfinished projects, recurring themes, and conversation clusters in your data.'
  },
  {
    icon: Zap,
    title: 'Semantic Search',
    description: 'Search your conversations by meaning, not just keywords. Find related discussions across all your imported data.'
  },
  {
    icon: Layers,
    title: 'Branch Navigation',
    description: 'Imported conversations maintain their branching structure. Explore different conversation paths visually.'
  },
  {
    icon: MousePointer,
    title: 'Canvas Controls',
    description: 'Use mouse wheel to zoom, space+drag to pan, and click+drag nodes to organize your workspace.'
  }
]
</script>

